{
  "functions": {
    "src/app/api/memories/route.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/ingest/:path*",
      "destination": "https://eu.i.posthog.com/:path*"
    },
    {
      "source": "/ingest",
      "destination": "https://eu.i.posthog.com/"
    },
    {
      "source": "/static/:path*",
      "destination": "https://eu-assets.i.posthog.com/static/:path*"
    }
  ]
}
